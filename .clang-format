---
# mini_tree 中间件统一代码风格（clang-format）
# 基准: Linux 内核风格 + Google C++ 风格
# 最低版本: clang-format >= 15（RemoveBracesLLVM）
#
# ── 命名规范（clang-format 无法强制，由 .clang-tidy readability-identifier-naming 强制）──
#   显式约定（C 中间件 / 内核风）: 除宏外全小写，宏全大写（container_of 等例外）。
#   Google C++ 风格作用域前缀:
#     s_  文件内 static 符号（不含 const）      s_bus / s_aht20_pool
#     g_  全局变量                              g_system_os_initialized
#     k_  常量（含 static const 表）             k_aht20_map / k_tag
#   函数以模块名作前缀（aht20_read），类型小写（struct event_bus）。
#   Google C++ 风格: class / using 别名 PascalCase，
#   namespace 小写，枚举值大写。

BasedOnStyle: LLVM

# ── 缩进（内核 Tab=8 / Google 2 空格，本工程统一 4 空格）──
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
IndentCaseLabels: false

# ── 大括号：Allman 风格（左大括号独占一行）──
BreakBeforeBraces: Allman

# 单语句 if/for/while 去掉大括号：
#   if (err) { return -1; }  →  if (err)
#                                 return -1;
RemoveBracesLLVM: true

# ── 短语句 / 短函数不压缩成单行 ──
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortBlocksOnASingleLine: Never

# ── 行宽 ──
ColumnLimit: 100

# ── 指针 / 引用 ──
DerivePointerAlignment: false
PointerAlignment: Left
ReferenceAlignment: Pointer
SpaceAfterCStyleCast: false

# ── 头文件排序 ──
SortIncludes: true

# ── 对齐（内核 / Google 风格均不对齐）──
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignConsecutiveMacros: false
AlignTrailingComments: false
SpacesBeforeTrailingComments: 1

# ── 运算符换行（运算符留在行尾）──
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: false

# ── 函数参数 ──
BinPackArguments: true
BinPackParameters: true

# ── C++（类 / 命名空间）──
AccessModifierOffset: -4
NamespaceIndentation: None
FixNamespaceComments: true
Cpp11BracedListStyle: true
