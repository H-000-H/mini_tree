---
# mini_tree 代码风格 = Linux 内核风格（kernel CodingStyle）
# 基准: Linux 内核官方 .clang-format（Documentation/process/clang-format 同款）
# 命名同为内核风: 全小写 snake_case, 不加 s_/g_/k_ 前缀, 函数以模块名作前缀, 宏全大写
#   （clang-format 管不了命名, 由 .clang-tidy readability-identifier-naming 强制,
#     详见 docs/cn/coding_style.md）

BasedOnStyle: LLVM

# ── Linux 内核 ──
AlignConsecutiveAssignments: true
AlignConsecutiveDeclarations: true
AlignEscapedNewlines: Left
AlignTrailingComments: true
AllowShortFunctionsOnASingleLine: false
AlwaysBreakAfterDefinitionReturnType: None
BreakBeforeBraces: Linux
BreakBeforeTernaryOperators: true
ColumnLimit: 100
Cpp11BracedListStyle: false
IndentCaseLabels: false
IndentWidth: 8
IndentWrappedFunctionNames: false
PointerAlignment: Right
SpacesBeforeTrailingComments: 1
TabWidth: 8
UseTab: Always
ContinuationIndentWidth: 8

# ── 头文件排序（项目保留项: poison 头固定最后）──
SortIncludes: true
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"compiler_compat_poison\.h"$'
    Priority: 100
  - Regex: '.*'
    Priority: 1
