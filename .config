
#
# mini_tree Configuration
#

#
# Platform
#
# CONFIG_PLATFORM_ARM_CM7 is not set
CONFIG_PLATFORM_ARM_CM4F=y
# CONFIG_PLATFORM_ARM_CM3 is not set
# CONFIG_PLATFORM_ARM_CM0 is not set
# CONFIG_PLATFORM_RISCV is not set
# CONFIG_PLATFORM_ESP32 is not set
# end of Platform

#
# Multi-core Configuration
#
CONFIG_CPU_CORES=1
# end of Multi-core Configuration

#
# OSAL Backend
#
# CONFIG_OSAL_MINI_OS is not set
# CONFIG_OSAL_FREERTOS is not set
# CONFIG_OSAL_RTTHREAD is not set
CONFIG_OSAL_NULL=y
CONFIG_OSAL_NULL_MAX_QUEUES=0
CONFIG_OSAL_NULL_QUEUE_BUF_SZ=2048
# CONFIG_OSAL_NULL_MINI_OS_MEM is not set
# CONFIG_OSAL_NULL_WFI is not set
CONFIG_OSAL_EVENT=y

#
# mini-os 内核调优 (CONFIG_MINI_OS_* 由 mini-os 三层配置体系直接消费)
#
# CONFIG_XTASK_NONE is not set
# CONFIG_XTASK_COOP is not set
CONFIG_XTASK_PREEMPT=y
CONFIG_XTASK_COROUTINE=y
CONFIG_OSAL_NULL_TASK_CPP=y
CONFIG_HARD_PRIORITY=8
CONFIG_X_PREEMPT_MAX_TASKS=8
# CONFIG_X_PREEMPT_PRIO_16 is not set
CONFIG_X_PREEMPT_PRIO_32=y
# CONFIG_X_PREEMPT_PRIO_64 is not set
CONFIG_X_PREEMPT_PRIO_LEVELS=32
CONFIG_X_PREEMPT_PRIO_PER_GROUP=8
# end of OSAL Backend

#
# OSAL Spinlock
#
CONFIG_OSAL_SPINLOCK_IRQ_DISABLE=y
# CONFIG_OSAL_SPINLOCK_ATOMIC is not set
# end of OSAL Spinlock

#
# System Log
#
# CONFIG_SYS_LOG_USE_PRINTF is not set
# CONFIG_SYS_LOG_USE_ESP is not set
CONFIG_SYS_LOG_USE_OSAL=y
# end of System Log

#
# System Runtime
#
CONFIG_SYSTEM=y
# CONFIG_SYSTEM_C is not set
CONFIG_SYSTEM_CPP=y
# CONFIG_SYSTEM_CMD is not set
# end of System Runtime

#
# Components
#
CONFIG_USB=y

#
# TinyUSB 适配层
#
CONFIG_USB_TUSB_MCU=901
CONFIG_USB_TUSB_OS_NONE=y
# CONFIG_USB_TUSB_OS_FREERTOS is not set
# CONFIG_USB_TUSB_OS_RTTHREAD is not set
# CONFIG_USB_TUSB_DEBUG is not set
CONFIG_USB_RHPORT0_DEVICE=y
# CONFIG_USB_RHPORT0_HOST is not set
# CONFIG_USB_RHPORT0_SPEED_DEFAULT is not set
CONFIG_USB_RHPORT0_SPEED_FULL=y
# CONFIG_USB_RHPORT0_SPEED_HIGH is not set
# CONFIG_USB_MSC is not set
# CONFIG_USB_HID is not set
# CONFIG_USB_VENDOR is not set
CONFIG_USB_CDC=y
CONFIG_USB_CDC_RX_BUFSIZE=256
CONFIG_USB_CDC_TX_BUFSIZE=512
CONFIG_USB_CDC_EP_BUFSIZE=64
# CONFIG_USB_NET is not set
# end of TinyUSB 适配层
# end of Components

#
# Board Features
#
# CONFIG_PRODUCTION_LOG is not set
# CONFIG_SAFETY_SHUTDOWN is not set
CONFIG_SYSTEM_WDT=y
# CONFIG_SYSTEM_SCRUBBER is not set
# end of Board Features

#
# Runtime Capacity
#
CONFIG_EVENT_BUS=y
CONFIG_EVENT_BUS_QUEUE_LEN=64
CONFIG_EVENT_BUS_MAX_SUBSCRIBERS=24
CONFIG_EVENT_BUS_DISPATCH_STACK=2048
# CONFIG_BUFFER_POOL is not set
CONFIG_VIRQ=y
CONFIG_BOTTOM_HALF_QUEUE_DEPTH=16
CONFIG_OSAL_MUTEX_POOL_SIZE=24
CONFIG_BOARD_STACK_MONITOR_MAX_TASKS=8
# end of Runtime Capacity

#
# Compiler Compatibility
#
CONFIG_COMPILER_GNU_EXTENSIONS=y
CONFIG_COMPILER_WARN_UNUSED_RESULT=y
# CONFIG_DEVICE_WARN_UNUSED_RESULT is not set
# end of Compiler Compatibility

#
# Build Options
#
CONFIG_BUILD_DISASM=y
# end of Build Options

#
# lwIP (TCP/IP Stack)
#
CONFIG_LWIP=y
CONFIG_SYS=y
CONFIG_SYS_LIGHTWEIGHT_PROT=y
# CONFIG_LWIP_COMPAT_MUTEX is not set

#
# Memory
#
CONFIG_MEM_ALIGNMENT=4
CONFIG_MEM_SIZE=32768
# CONFIG_MEM_LIBC_MALLOC is not set
CONFIG_MEMP_NUM_PBUF=16
CONFIG_MEMP_NUM_TCP_PCB=5
CONFIG_MEMP_NUM_UDP_PCB=4
CONFIG_MEMP_NUM_TCP_PCB_LISTEN=4
CONFIG_MEMP_NUM_TCP_SEG=16
CONFIG_MEMP_NUM_SYS_TIMEOUT=10
# end of Memory

#
# PBUF Pool
#
CONFIG_PBUF_POOL_SIZE=16
CONFIG_PBUF_POOL_BUFSIZE=592
# end of PBUF Pool

#
# Protocols
#
# CONFIG_LWIP_RAW is not set
CONFIG_LWIP_TIMERS=y
CONFIG_LWIP_UDP=y
CONFIG_UDP_TTL=255
CONFIG_LWIP_TCP=y
CONFIG_TCP_TTL=255
CONFIG_TCP_MSS=536
CONFIG_TCP_WND=2048
CONFIG_TCP_SND_BUF=2048
CONFIG_TCP_SERVER_MAX_CLIENTS=4
CONFIG_TCP_RX_BUF_SIZE=2048

#
# TCP Client (net/port/tcp/tcp_client.c)
#
CONFIG_TCP_CLIENT_RX_BUFFER_SIZE=1024
CONFIG_TCP_CLIENT_TX_BUFFER_SIZE=1024
CONFIG_TCP_CLIENT_RX_TX_BYTE_TYPE=1
# end of TCP Client (net/port/tcp/tcp_client.c)

#
# MQTT Client (net/port/mqtt/mqtt_client.c)
#
CONFIG_NET_MQTT_USE_COREMQTT=y
CONFIG_MQTT_NET_BUFFER_SIZE=2048
CONFIG_MQTT_CLIENT_ID="mini_node"
# end of MQTT Client (net/port/mqtt/mqtt_client.c)

CONFIG_LWIP_ETHERNET=y
# CONFIG_LWIP_CHECKSUM_CTRL_PER_NETIF is not set
CONFIG_LWIP_NETIF_STATUS_CALLBACK=y
CONFIG_LWIP_NETIF_LINK_CALLBACK=y
# CONFIG_LWIP_NETIF_API is not set
CONFIG_LWIP_ICMP=y
# CONFIG_LWIP_ICMP6 is not set
CONFIG_LWIP_ARP=y
CONFIG_ARP_TABLE_SIZE=10
CONFIG_LWIP_IPV4=y
# CONFIG_LWIP_IPV6 is not set
CONFIG_IP_REASSEMBLY=y
CONFIG_IP_FRAG=y
# CONFIG_IP_FRAG_USES_STATIC_BUF is not set
CONFIG_LWIP_DHCP=y
# CONFIG_LWIP_AUTOIP is not set
CONFIG_LWIP_DNS=y
# end of Protocols

#
# PPP (4G/Modem over Serial)
#
# CONFIG_PPP_SUPPORT is not set

#
# PPPIF (pppif 适配层)
#
# end of PPPIF (pppif 适配层)
# end of PPP (4G/Modem over Serial)

#
# Checksum
#
CONFIG_CHECKSUM_GEN_IP=y
CONFIG_CHECKSUM_GEN_UDP=y
CONFIG_CHECKSUM_GEN_TCP=y
CONFIG_CHECKSUM_CHECK_IP=y
CONFIG_CHECKSUM_CHECK_UDP=y
CONFIG_CHECKSUM_CHECK_TCP=y
# end of Checksum

#
# Debug
#
# CONFIG_LWIP_DEBUG is not set
# CONFIG_LWIP_STATS is not set
# end of Debug
# end of lwIP (TCP/IP Stack)
# end of mini_tree Configuration
