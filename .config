
#
# mini_tree Configuration
#

#
# Platform
#
CONFIG_PLATFORM_ESP32=y
# end of Platform

#
# Multi-core Configuration
#
CONFIG_CPU_CORES=1
# end of Multi-core Configuration

#
# OSAL Backend
#
CONFIG_OSAL_FREERTOS=y
# CONFIG_OSAL_NULL is not set
CONFIG_OSAL_EVENT=y
CONFIG_FREERTOS_USE_TIMERS=y
CONFIG_FREERTOS_HEAP_SIZE=8192
CONFIG_FREERTOS_EVENT_GROUPS=y
# end of OSAL Backend

#
# OSAL Spinlock
#
CONFIG_OSAL_SPINLOCK_IRQ_DISABLE=y
# CONFIG_OSAL_SPINLOCK_ATOMIC is not set
# end of OSAL Spinlock

#
# System Log
#
CONFIG_SYS_LOG_USE_PRINTF=y
# CONFIG_SYS_LOG_USE_ESP is not set
# CONFIG_SYS_LOG_USE_OSAL is not set
# end of System Log

#
# System Runtime
#
CONFIG_SYSTEM=y
# CONFIG_SYSTEM_C is not set
CONFIG_SYSTEM_CPP=y
# CONFIG_SYSTEM_CMD is not set
# end of System Runtime

#
# Components
#
# CONFIG_USB is not set

#
# TinyUSB 适配层
#
# end of TinyUSB 适配层
# end of Components

#
# Board Features
#
# CONFIG_PRODUCTION_LOG is not set
# CONFIG_SAFETY_SHUTDOWN is not set
CONFIG_SYSTEM_WDT=y
# CONFIG_SYSTEM_SCRUBBER is not set
# end of Board Features

#
# Runtime Capacity
#
# CONFIG_EVENT_BUS is not set
# CONFIG_BUFFER_POOL is not set
CONFIG_VIRQ=y
CONFIG_BOTTOM_HALF_QUEUE_DEPTH=16
CONFIG_OSAL_MUTEX_POOL_SIZE=24
CONFIG_BOARD_STACK_MONITOR_MAX_TASKS=8
# end of Runtime Capacity

#
# Compiler Compatibility
#
CONFIG_COMPILER_GNU_EXTENSIONS=y
CONFIG_COMPILER_WARN_UNUSED_RESULT=y
# CONFIG_DEVICE_WARN_UNUSED_RESULT is not set
# end of Compiler Compatibility

#
# Build Options
#
CONFIG_BUILD_DISASM=y
# end of Build Options

#
# lwIP (TCP/IP Stack)
#
# CONFIG_LWIP is not set
# CONFIG_SYS is not set
# CONFIG_LWIP_COMPAT_MUTEX is not set

#
# TCP/IP Core Thread
#
CONFIG_TCPIP_THREAD_NAME="tcpip_thread"
CONFIG_TCPIP_THREAD_STACKSIZE=1024
CONFIG_TCPIP_THREAD_PRIO=6
CONFIG_TCPIP_MBOX_SIZE=8
# end of TCP/IP Core Thread

#
# Default Receive Mailbox Sizes
#
CONFIG_DEFAULT_RAW_RECVMBOX_SIZE=8
CONFIG_DEFAULT_UDP_RECVMBOX_SIZE=8
CONFIG_DEFAULT_TCP_RECVMBOX_SIZE=8
CONFIG_DEFAULT_ACCEPTMBOX_SIZE=8
# end of Default Receive Mailbox Sizes

#
# Memory
#
CONFIG_MEM_ALIGNMENT=4
CONFIG_MEM_SIZE=16384
# CONFIG_MEM_LIBC_MALLOC is not set
CONFIG_MEMP_NUM_PBUF=16
CONFIG_MEMP_NUM_TCP_PCB=5
CONFIG_MEMP_NUM_UDP_PCB=4
CONFIG_MEMP_NUM_TCP_PCB_LISTEN=4
CONFIG_MEMP_NUM_TCP_SEG=16
CONFIG_MEMP_NUM_SYS_TIMEOUT=10
# end of Memory

#
# PBUF Pool
#
CONFIG_PBUF_POOL_SIZE=16
CONFIG_PBUF_POOL_BUFSIZE=592
# end of PBUF Pool

#
# Protocols
#
# CONFIG_LWIP_RAW is not set
CONFIG_LWIP_TIMERS=y
CONFIG_LWIP_UDP=y
CONFIG_UDP_TTL=255
CONFIG_LWIP_TCP=y
CONFIG_TCP_TTL=255
CONFIG_TCP_MSS=536
CONFIG_TCP_WND=2048
CONFIG_TCP_SND_BUF=2048
CONFIG_TCP_SERVER_MAX_CLIENTS=4
CONFIG_TCP_RX_BUF_SIZE=2048

#
# TCP Client (net/port/tcp/tcp_client.c)
#
CONFIG_TCP_CLIENT_RX_BUFFER_SIZE=1024
CONFIG_TCP_CLIENT_TX_BUFFER_SIZE=1024
CONFIG_TCP_CLIENT_RX_TX_BYTE_TYPE=1
# end of TCP Client (net/port/tcp/tcp_client.c)

#
# MQTT Client (net/port/mqtt/mqtt_client.c)
#
CONFIG_NET_MQTT_USE_COREMQTT=y
CONFIG_MQTT_NET_BUFFER_SIZE=2048
CONFIG_MQTT_CLIENT_ID="mini_node"
# end of MQTT Client (net/port/mqtt/mqtt_client.c)

CONFIG_LWIP_ETHERNET=y
# CONFIG_LWIP_CHECKSUM_CTRL_PER_NETIF is not set
CONFIG_LWIP_NETIF_STATUS_CALLBACK=y
CONFIG_LWIP_NETIF_LINK_CALLBACK=y
# CONFIG_LWIP_NETIF_API is not set
CONFIG_LWIP_ICMP=y
# CONFIG_LWIP_ICMP6 is not set
CONFIG_LWIP_ARP=y
CONFIG_ARP_TABLE_SIZE=10
CONFIG_LWIP_IPV4=y
# CONFIG_LWIP_IPV6 is not set
CONFIG_IP_REASSEMBLY=y
CONFIG_IP_FRAG=y
# CONFIG_IP_FRAG_USES_STATIC_BUF is not set
CONFIG_LWIP_DHCP=y
# CONFIG_LWIP_AUTOIP is not set
CONFIG_LWIP_DNS=y
# end of Protocols

#
# Checksum
#
CONFIG_CHECKSUM_GEN_IP=y
CONFIG_CHECKSUM_GEN_UDP=y
CONFIG_CHECKSUM_GEN_TCP=y
CONFIG_CHECKSUM_CHECK_IP=y
CONFIG_CHECKSUM_CHECK_UDP=y
CONFIG_CHECKSUM_CHECK_TCP=y
# end of Checksum

#
# Socket / Netconn API
#
CONFIG_LWIP_NETCONN=y
CONFIG_LWIP_SOCKET=y
CONFIG_LWIP_NETCONN_RECVTIMEO=y
CONFIG_LWIP_SO_RCVTIMEO=y
CONFIG_LWIP_SO_SNDTIMEO=y
# CONFIG_LWIP_SO_RCVBUF is not set
CONFIG_LWIP_TIMEVAL_PRIVATE=y
CONFIG_LWIP_POSIX_SOCKETS_IO_NAMES=y
# end of Socket / Netconn API

#
# Socket/Netconn Memory Pools
#
CONFIG_MEMP_NUM_NETCONN=8
CONFIG_MEMP_NUM_NETBUF=8
CONFIG_MEMP_NUM_SELECT_CB=4
CONFIG_MEMP_NUM_TCPIP_MSG_API=16
CONFIG_MEMP_NUM_TCPIP_MSG_INPKT=16
# end of Socket/Netconn Memory Pools

#
# Debug
#
# CONFIG_LWIP_DEBUG is not set
# CONFIG_LWIP_STATS is not set
# end of Debug
# end of lwIP (TCP/IP Stack)
# end of mini_tree Configuration
