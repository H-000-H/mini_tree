# mini_tree Kconfig — 公共配置树 (ESP / 非 ESP 共用)
# 本文件不包含 mainmenu; 由根 Kconfig (非 ESP) 或 Kconfig.projbuild (ESP-IDF) source 进去。
# 编辑 .config 或运行 tools/menuconfig.py

menu "mini_tree Configuration"

menu "Platform"
choice
    prompt "Target MCU"
    default PLATFORM_ARM_CM4F
    help
      Select the target processor architecture.

config PLATFORM_ARM_CM7
    bool "ARM Cortex-M7"

config PLATFORM_ARM_CM4F
    bool "ARM Cortex-M4F"

config PLATFORM_ARM_CM3
    bool "ARM Cortex-M3"

config PLATFORM_ARM_CM0
    bool "ARM Cortex-M0 / M0+"

config PLATFORM_RISCV
    bool "RISC-V (32-bit)"

config PLATFORM_ESP32
    bool "Espressif ESP32 (ESP-IDF)"
    help
      Espressif ESP32 系列 (Xtensa; RISC-V 的 ESP32-C 系列在 IDF 下也选此项)。
      ESP-IDF 工程**必须**选中此项 (sdkconfig.defaults 显式设置), 作为工程
      平台身份声明; 非 ESP 裸机构建不要选它, 用 ARM / RISC-V 平台选项。

      编译行为本身由 IDF 管理 (ESP_PLATFORM 编译宏 + cmake/esp_idf.cmake),
      本选项不直接参与编译裁剪; 但它标识"本工程是 ESP 平台", 与 HAL
      全屏蔽机制配套: ESP 构建下 mini_tree 的 HAL weak stub 被
      #if defined(ESP_PLATFORM) 屏蔽, 板级组件 (hal_<soc>) 必须提供
      strong 实现, 缺失直接链接报错。

      Espressif ESP32 series (Xtensa; ESP32-C RISC-V parts also select
      this when built with ESP-IDF). ESP-IDF projects MUST select this
      (set in sdkconfig.defaults) as a platform identity declaration;
      non-ESP bare-metal builds must keep the ARM / RISC-V options.

      Compilation is managed by IDF itself (ESP_PLATFORM macro +
      cmake/esp_idf.cmake); this option does not directly drive the
      build, but declares "this project is ESP", pairing with the HAL
      shutdown: on ESP builds mini_tree HAL weak stubs are excluded by
      #if defined(ESP_PLATFORM) and the board component (hal_<soc>)
      must provide strong implementations (link error if missing).
endchoice
endmenu

menu "Multi-core Configuration"

config CPU_CORES
    int "Number of CPU cores"
    default 1
    range 1 2
    help
      CPU 核心数量。1 = 单核模式（默认）。
      2 = 双核 AMP 模式，Core 0 跑 RTOS，
      Core 1 跑裸机代码。
      设为 2 时板级需实现
      hal_cpu_secondary_startup()。

      Number of CPU cores. 1 = single-core mode (default).
      2 = dual-core AMP mode, Core 0 runs the RTOS,
      Core 1 runs bare-metal code.
      When set to 2, the board must implement
      hal_cpu_secondary_startup().

config AMP_MODE
    bool "AMP mode (multi-core)"
    depends on CPU_CORES > 1
    default y
    help
      双核 AMP 模式使能。AMP 模式下 osal_null 的互斥锁
      等同步原语使用原子 CAS 实现；单核模式下退化为
      关中断 + 普通变量访问，减少开销。
      注意: M0/M0+ (ARMv6-M) 无 LDREX/STREX 指令, 跨核
      原子性无硬件保证; 若 M0 作异构从核, 应避免跨核共享锁。
      Dual-core AMP mode. Under AMP, osal_null mutexes use
      atomic CAS; single-core falls back to IRQ-lock + plain
      access. Note: M0/M0+ (ARMv6-M) has no LDREX/STREX, so
      cross-core atomicity is not guaranteed; when M0 is a
      heterogeneous slave core, avoid sharing locks across cores.

endmenu

menu "OSAL Backend"
choice
    prompt "RTOS backend"
    default OSAL_NULL
    help
      选择 OS 抽象层后端。

      Select the OS abstraction layer backend.

config OSAL_FREERTOS
    bool "FreeRTOS"
    select USB_TUSB_OS_FREERTOS
    help
      使用仓库内置或项目自带的 FreeRTOS。

      Use bundled or project-supplied FreeRTOS.

config OSAL_RTTHREAD
    bool "RT-Thread"
    select USB_TUSB_OS_RTTHREAD
    help
      使用 RT-Thread 内核作为 OSAL 后端。

      Use RT-Thread kernel as OSAL backend.

config OSAL_THREADX
    bool "Eclipse ThreadX"
    select USB_TUSB_OS_THREADX
    help
      使用 Eclipse ThreadX (v6.5.1) 作为 OSAL 后端。
      许可 MIT (Eclipse 基金会托管, 商用友好)。
      端口按 Kconfig PLATFORM 自动派生 (lib/threadx/ports/cortex_*/gnu);
      内核配置见 lib/threadx/tx_user.h (1 ms tick + 栈检查)。
      板级集成: 需改写 ports/cortex_m4/gnu/example_build/ 下的
      tx_initialize_low_level.S (SysTick 1000 Hz) 并接线 tx_kernel_enter() /
      tx_application_define()。任务控制块与栈由 OSAL 层 calloc 动态分配
      (RAM 占用最小, 见 docs/memory_footprint.md §3.1.1)。

      Use Eclipse ThreadX (v6.5.1) as the OSAL backend.
      MIT licensed (hosted by the Eclipse Foundation, commercial-friendly).
      Port is derived from Kconfig PLATFORM (lib/threadx/ports/cortex_*/gnu);
      kernel config in lib/threadx/tx_user.h (1 ms tick + stack checking).
      Board integration: edit tx_initialize_low_level.S under
      ports/cortex_m4/gnu/example_build/ (SysTick 1000 Hz) and wire
      tx_kernel_enter() / tx_application_define(). TCB and stack are
      calloc'd by the OSAL layer (minimal RAM, see docs/memory_footprint.md §3.1.1).

config OSAL_UCOS_III
    bool "uC/OS-III"
    select USB_TUSB_OS_NONE
    help
      使用 Micrium uC/OS-III (V3.08.02) 作为 OSAL 后端。
      注意: TinyUSB 无 uC/OS 适配层, CFG_TUSB_OS 自动回退 None (裸机互斥)。
      许可 Apache-2.0 (Micrium/Silicon Labs 开源)。
      依赖 lib/uC-CPU + lib/uC-LIB (需随仓克隆, weston-embedded);
      项目配置副本 lib/uC-OS3/Cfg/ (os_cfg.h: DBG=1, 任务名入 TCB;
      os_cfg_app.h: OS_CFG_MSG_POOL_SIZE=256 — 全系统并发在途队列消息上限)。
      优先级 0 最高, 数小优先高; 队列传指针, OSAL 层自建定长槽环。
      板级集成: OSInit() → OSStart(), SysTick 挂 OS_CPU_SysTickHandler,
      ISR 包 OSIntEnter/OSIntExit。

      Use Micrium uC/OS-III (V3.08.02) as the OSAL backend.
      Apache-2.0 licensed (Micrium/Silicon Labs, open source).
      Depends on lib/uC-CPU + lib/uC-LIB (clone with the repo, weston-embedded);
      config copy at lib/uC-OS3/Cfg/ (os_cfg.h: DBG=1, task name in TCB;
      os_cfg_app.h: OS_CFG_MSG_POOL_SIZE=256 — system-wide in-flight queue
      message cap). Priority 0 is highest; queues pass pointers, OSAL
      builds a fixed-slot ring. Board integration: OSInit() → OSStart(),
      SysTick to OS_CPU_SysTickHandler, ISR wrapped with OSIntEnter/OSIntExit.

config OSAL_UCOS_II
    bool "uC/OS-II"
    select USB_TUSB_OS_NONE
    help
      使用 Micrium uC/OS-II (V2.93.01) 作为 OSAL 后端。
      注意: TinyUSB 无 uC/OS 适配层, CFG_TUSB_OS 自动回退 None (裸机互斥)。
      许可 Apache-2.0 (Micrium/Silicon Labs 开源)。
      注意: 每优先级仅允许一个任务 (0~63; 61/62/63 保留给 tmr/stat/idle),
      任务句柄即优先级号。项目配置副本 lib/uC-OS2/Cfg/
      (os_cfg.h: 1 ms tick、OS_MAX_EVENTS=24、OS_MAX_QS=8;
      app_cfg.h: 端口要求的 CPU_CFG_KA_IPL_BOUNDARY / NVIC_PRIO_BITS)。
      OS_EVENT 控制块来自内核池 (OS_MAX_EVENTS/OS_MAX_QS 为上限)。
      板级集成: OSInit() → OSStart(), SysTick 挂 OS_CPU_SysTickHandler,
      ISR 包 OSIntEnter/OSIntExit。

      Use Micrium uC/OS-II (V2.93.01) as the OSAL backend.
      Apache-2.0 licensed (Micrium/Silicon Labs, open source).
      Note: only one task per priority (0~63; 61/62/63 reserved for
      tmr/stat/idle); the task handle IS the priority number. Config copy
      at lib/uC-OS2/Cfg/ (os_cfg.h: 1 ms tick, OS_MAX_EVENTS=24,
      OS_MAX_QS=8; app_cfg.h: port-required CPU_CFG_KA_IPL_BOUNDARY /
      NVIC_PRIO_BITS). OS_EVENT blocks come from the kernel pool
      (OS_MAX_EVENTS/OS_MAX_QS caps). Board integration: OSInit() →
      OSStart(), SysTick to OS_CPU_SysTickHandler, ISR wrapped with
      OSIntEnter/OSIntExit.

config OSAL_NULL
    bool "None (bare-metal)"
    select USB_TUSB_OS_NONE
    help
      无 RTOS。队列使用环形缓冲 + 忙等待。

      No RTOS. Queue uses ring buffer + busy-wait.
endchoice

config OSAL_NULL_MAX_QUEUES
    int "Bare-metal queue pool size (base)"
    default 0
    range 0 8
    depends on OSAL_NULL
    help
      裸机队列池基础大小 (静态预分配, 供手动 osal_queue_create 使用)。
      开启 EVENT_BUS 时自动在此基础上 +1 (EventBus 需要一个队列);
      关闭 (默认) 时仅基础数。

      Base bare-metal static queue pool size (for manual osal_queue_create).
      When EVENT_BUS is enabled, 1 is auto-added on top (EventBus needs a
      queue); when off (default), only the base counts.

config OSAL_NULL_QUEUE_BUF_SZ
    int "Per-queue buffer size (bytes)"
    default 2048
    range 512 8192
    depends on OSAL_NULL
    help
      每个队列静态内嵌的元素缓冲 (字节)。
      2048 B = 512 个基础单元, EventBus (64×8 B) 约占 1/4。
      下限 512 B 保证默认 EventBus 队列 (128 单元) 可创建。

      Element buffer embedded in each bare-metal queue.
      2048 B = 512 base units; EventBus (64×8 B) uses ~1/4.
      Lower bound 512 B keeps the default EventBus queue (128 units) creatable.

config OSAL_NULL_WFI
    bool "裸机忙等用 WFI 休眠唤醒 (默认关, 纯轮询) / Bare-metal busy-wait via WFI (default off, plain spin)"
    default n
    depends on OSAL_NULL
    help
      裸机等锁/等信号量/等队列时的忙等策略:
      开启: 等锁循环里执行 WFI 进入低功耗, 靠中断 (tick) 唤醒后重试 —
            省电, 但响应依赖中断唤醒, 且抢占调度器下 WFI 会让整个系统
            空睡, 其他任务 (含持锁方) 无法推进, 只能等超时;
      关闭 (默认): 纯轮询 (spin), 不依赖中断, 响应最快, 但空转耗电。
      在裸机抢占调度器 (XTASK_PREEMPT) 下绝大多数场景建议保持默认关闭。

      Busy-wait policy for bare-metal lock/sem/queue waits:
      On: execute WFI in the wait loop and rely on an interrupt (tick) to
          wake and retry — saves power, but retry latency depends on the
          interrupt, and under the preemptive scheduler WFI idles the whole
          system so other tasks (including the lock owner) cannot advance;
      Off (default): plain spin with no interrupt dependency — lowest
          latency, at the cost of power. Under the preemptive scheduler
          (XTASK_PREEMPT) keep this off in most cases.

choice
    prompt "裸机调度器 (Bare-metal scheduler)"
    default XTASK_COOP
    depends on OSAL_NULL
    help
      裸机 (CONFIG_OSAL_NULL) 下的任务调度方式, 三选一:
      无调度 / 协调式 / 抢占式。OS 后端由各自内核调度, 无此选项。

      Scheduler for the bare-metal (CONFIG_OSAL_NULL) backend:
      none / cooperative / preemptive. OS backends schedule via their
      own kernels and ignore this choice.

config XTASK_NONE
    bool "无调度器 (自己写 while 大循环) / No scheduler (own while-loop)"
    help
      不编入任何调度器。应用层自己写 while(1) 大循环 + 轮询
      (如 mini_tree_system_loop), 不提供 xscheduler_* 原生 API。
      time_slice/ 头路径不暴露, OSAL_NULL_TASK_CPP C++ 封装需同步关闭。

      No scheduler is compiled. Drive everything from your own
      while(1) loop (e.g. mini_tree_system_loop); the xscheduler_*
      native APIs and time_slice/ headers are not available, and the
      OSAL_NULL_TASK_CPP C++ wrapper must be disabled too.

config XTASK_COOP
    bool "协调式时间片 (xtask_coop.c) / Cooperative round-robin"
    help
      普通 (裸机) 协调式时间片调度器 (time_slice/task/xtask_coop.c)。
      提供 xscheduler_task_create() / x_scheduler_poll()
      等原生 API, 也是 OSAL_NULL_TASK_CPP C++ 封装 (osal_task.cpp) 的底层。
      默认 tick 源为 Cortex-M SysTick (内核异常, 不经 VIRQ), 关闭 VIRQ 时
      SysTick 路径照常 tick; 仅当 DTS 显式配 chosen TIM (走通用 TIM + VIRQ)
      时, 关闭 VIRQ 才导致该 TIM 中断无法路由、调度器无 tick。

      Bare-metal cooperative round-robin time-slice scheduler
      (time_slice/task/xtask_coop.c). Exposes the
      native xscheduler_task_create() / x_scheduler_poll() APIs that the
      OSAL_NULL_TASK_CPP C++ wrapper (osal_task.cpp) builds on.
      The default tick source is the Cortex-M SysTick (core exception, not
      via VIRQ), so the SysTick path keeps ticking even with VIRQ off; only
      when DTS explicitly sets chosen TIM (generic TIM + VIRQ) does disabling
      VIRQ break TIM IRQ routing and leave the scheduler with no tick.

config XTASK_PREEMPT
    bool "抢占式 (xtask_preempt.c) / Preemptive"
    help
      N+1 链表多优先级抢占式调度器 (可延迟/可休眠/可抢占), 独立编译为
      time_slice/task/xtask_preempt.c, 与协调式 xtask_coop.c 共用 xtask.h。
      开启后**替换**协调式 (xtask_coop.c 不再编入), 两套实现提供同一套
      对外 API (xscheduler_task_create / x_scheduler_poll / xscheduler_start 等),
      调用方代码无需任何改动。
      已完工可编译 (分组优先级 + CLZ 定位最高就绪, O(1); 无就绪任务时精确
      WFI 到最早到期时刻)。choice 默认仍是 XTASK_COOP, 需要更接近 RTOS 的
      调度体验时切换到本项。
      N+1 linked-list multi-priority preemptive scheduler
      (delayable / sleepable / preemptive), compiled separately as
      time_slice/task/xtask_preempt.c, sharing xtask.h with the basic
      round-robin xtask_coop.c. When enabled, it REPLACES xtask_coop.c
      (the cooperative version is no longer compiled); both implementations
      expose the same API (xscheduler_task_create / x_scheduler_poll /
      xscheduler_start, etc.), so caller code needs no changes.
      Finished & compilable (grouped priorities + CLZ for O(1) highest-ready
      selection; precise WFI to the earliest deadline when idle). The choice
      still defaults to XTASK_COOP; pick this one when you want a more
      RTOS-like scheduling experience on bare-metal.

endchoice

config XTASK_COROUTINE
    bool "protothread 协程让出 (PT_DELAY/PT_YIELD) / protothread coroutine yields"
    default y
    depends on OSAL_NULL && !XTASK_NONE
    help
      开启后任务回调可用 protothread 宏 (xtask.h): PT_BEGIN / PT_YIELD /
      PT_WAIT_UNTIL / PT_DELAY / PT_END。任务回调内延时让出执行权 (挂起到期点),
      其他任务继续跑, 到期后从让出点恢复 —— 无堆、无独立栈 (仅 x_task.pt_line
      一个字段)。
      开启 (默认): 默认可用协程; 不写 PT 宏的普通回调行为完全不变 (兼容)。
      关闭: 不定义 PT_ 宏, 调度器不做协程判定, 回调保持纯
      run-to-completion (周期推进)。
      两种调度器 (XTASK_COOP / XTASK_PREEMPT) 均支持本选项。

      When enabled, task callbacks may use the protothread macros
      (xtask.h): PT_BEGIN / PT_YIELD / PT_WAIT_UNTIL / PT_DELAY / PT_END.
      Delays inside a callback yield the execution (suspend until the
      deadline), letting other tasks run and resuming from the yield
      point — no heap, no per-task stack (just the x_task.pt_line field).
      On (default): coroutines available; plain callbacks without PT
      macros behave exactly as before (backward compatible).
      When off: the PT_ macros are not defined, the scheduler skips
      coroutine handling, and callbacks stay plain run-to-completion
      (periodic).
      Supported by both schedulers (XTASK_COOP / XTASK_PREEMPT).

config OSAL_NULL_TASK_CPP
    bool "Bare-metal task create C++ wrapper (unified OSAL vs raw xtask)"
    default y
    depends on OSAL_NULL && SYSTEM_CPP && !XTASK_NONE
    help
      裸机任务创建的 C++ 封装 (osal/src/osal_task.cpp), 需要 SYSTEM_CPP (C++ 构建)。
      开启 (默认): 走统一 OSAL 路径 — 通过 C++ 重载 osal_task_create() 创建
      xtask 周期任务, 返回 etl::optional<x_task_handle_t>, 调用习惯与 OS 后端
      对齐 (参数语义见 osal_null.h 中该重载的注释)。
      关闭: 靠 xtask 自己 — 不编译封装, 直接调用 xscheduler_task_create() /
      x_scheduler_poll() 等 xtask 原生 API。
      仅裸机 (CONFIG_OSAL_NULL) 生效; OS 后端任务创建始终走标准 C API。

      Bare-metal task-create C++ wrapper (osal/src/osal_task.cpp), needs
      SYSTEM_CPP (C++ build). On (default): unified OSAL path — create
      xtask periodic tasks via the C++ overload osal_task_create(), which
      returns etl::optional<x_task_handle_t> and keeps the OSAL calling
      convention (parameter semantics are documented on that overload in
      osal_null.h). Off: raw xtask — the wrapper is not compiled; call
      xscheduler_task_create() / x_scheduler_poll() directly.
      Bare-metal (CONFIG_OSAL_NULL) only; on OS backends task creation
      always goes through the standard C API.

config HARD_PRIORITY
    int "Generate Hardware interrupt priority Max Number"
    default 8
    depends on XTASK_PREEMPT
    help 
      N+1链表的最大硬件优先级的数量默认和虚拟中断数一样,不要大于虚拟中断的数量不然容易虚拟中断越界

config X_PREEMPT_MAX_TASKS
    int "Preemptive scheduler task pool size"
    default 8
    range 1 32
    depends on XTASK_PREEMPT
    help
      抢占式调度器 (xtask_preempt.c) 的静态任务池容量, 预分配无动态内存。
      每个任务一份 x_preempt_task 包装结构, 池满时 x_scheduler_task_create 返回失败。

      Static task-pool capacity of the preemptive scheduler
      (xtask_preempt.c); pre-allocated, no dynamic memory.
      One x_preempt_task wrapper per slot; task creation fails when full.

choice
    prompt "Preemptive scheduler total priority levels"
    default X_PREEMPT_PRIO_32
    depends on XTASK_PREEMPT
    help
      抢占式调度器总优先级级数。越大优先级分辨率越高, 位图/链表开销越大。
      总级数必须是每组级数 (X_PREEMPT_PRIO_PER_GROUP) 的整数倍。

      Total priority levels of the preemptive scheduler. Higher
      resolution costs more bitmap/list memory. Must be a multiple of
      X_PREEMPT_PRIO_PER_GROUP.

config X_PREEMPT_PRIO_16
    bool "16 levels"
    help
      16 级: 可选布局 1×16, 2×8, 4×4, 8×2, 16×1。

      16 levels: layouts include 1×16, 2×8, 4×4, 8×2, 16×1.

config X_PREEMPT_PRIO_32
    bool "32 levels"
    help
      32 级 (默认): 可选布局 1×32, 2×16, 4×8, 8×4, 16×2, 32×1。

      32 levels (default): layouts include 1×32, 2×16, 4×8, 8×4,
      16×2, 32×1.

config X_PREEMPT_PRIO_64
    bool "64 levels"
    help
      64 级: 可选布局 2×32, 4×16, 8×8, 16×4, 32×2, 64×1。
      注意 PER_GROUP=1 时组数=64 超位图, 会被编译期拦截。

      64 levels: layouts include 2×32, 4×16, 8×8, 16×4, 32×2, 64×1.
      Note PER_GROUP=1 yields 64 groups which exceeds the bitmap and
      is rejected at compile time.

endchoice

config X_PREEMPT_PRIO_LEVELS
    int
    default 16 if X_PREEMPT_PRIO_16
    default 32 if X_PREEMPT_PRIO_32
    default 64 if X_PREEMPT_PRIO_64
    depends on XTASK_PREEMPT
    help
      抢占式调度器总优先级级数 (由上方 choice 推导, 代码经
      CONFIG_X_PREEMPT_PRIO_LEVELS 读取): 16 / 32 / 64。
      与 X_PREEMPT_PRIO_PER_GROUP 配合得到具体布局 (如 32 + 8 = 4×8)。

      Total preemptive priority levels (derived from the choice above,
      consumed by code as CONFIG_X_PREEMPT_PRIO_LEVELS): 16 / 32 / 64.
      Combined with X_PREEMPT_PRIO_PER_GROUP for the concrete layout
      (e.g. 32 + 8 = 4×8).

config X_PREEMPT_PRIO_PER_GROUP
    int "Preemptive scheduler priority levels per group"
    default 8
    range 2 16
    depends on XTASK_PREEMPT
    help
      每组包含的优先级级数。组数 = 总级数 / 每组级数, 自动推导。
      与总级数配合得到具体布局, 例如:
        - 总 32 级 + 每组 8  → 4×8 (默认)
        - 总 32 级 + 每组 16 → 2×16
        - 总 64 级 + 每组 8  → 8×8
      组数必须 ≤ 32 (位图 uint32_t 限制); 每组级数需整除总级数。

      Priority levels per ready-list group. Group count is derived as
      LEVELS / PER_GROUP. Examples with the chosen LEVELS:
        - 32 levels + 8/group  → 4×8 (default)
        - 32 levels + 16/group → 2×16
        - 64 levels + 8/group  → 8×8
      Group count must be ≤ 32 (uint32_t bitmap limit) and PER_GROUP
      must divide LEVELS.

config FREERTOS_USE_TIMERS
    bool "FreeRTOS software timers"
    default n
    depends on OSAL_FREERTOS
    help
      开启 FreeRTOS 软件定时器（对应 lib/freeRTOS/FreeRTOSConfig.h 中的
      configUSE_TIMERS）。默认关闭。

      Enable FreeRTOS software timers (configUSE_TIMERS in
      lib/freeRTOS/FreeRTOSConfig.h). Default off.

config FREERTOS_HEAP_SIZE
    int "FreeRTOS heap size (bytes)"
    default 8192
    range 2048 131072
    depends on OSAL_FREERTOS
    help
      FreeRTOS 动态堆大小 (configTOTAL_HEAP_SIZE), 供任务栈/信号量/队列分配。
      默认 8 KB; 任务多/栈大时按需调大。
      FreeRTOS dynamic heap (configTOTAL_HEAP_SIZE) for task stacks,
      semaphores and queues. Default 8 KB; raise when many/large tasks.

config RTT_HEAP_SIZE
    int "RT-Thread heap size (bytes)"
    default 32768
    range 4096 1048576
    depends on OSAL_RTTHREAD
    help
      RT-Thread 独立系统堆大小 (s_rtt_heap, 静态 .bss), 供线程栈/IPC 分配。
      默认 32 KB。
      RT-Thread independent system heap (static .bss) for stacks and IPC.
      Default 32 KB.
endmenu

menu "OSAL Spinlock"
choice
    prompt "Spinlock implementation"
    default OSAL_SPINLOCK_IRQ_DISABLE
    help
      选择底层自旋锁实现。

      Select the underlying spinlock implementation.

config OSAL_SPINLOCK_IRQ_DISABLE
    bool "Disable interrupts (single-core safe)"
    help
      自旋锁映射到 irq_disable/irq_restore。裸机与单核 RTOS 均安全。
      这是默认实现。

      Map spinlock to irq_disable/irq_restore. Safe for bare-metal
      and single-core RTOS. This is the default.

config OSAL_SPINLOCK_ATOMIC
    bool "Atomic test-and-set (busy-wait)"
    help
      使用原子 test-and-set 的真忙等自旋锁。
      仅在 SMP/多核系统安全，且持有上下文可运行于另一核。
      注意：在 M0/M0+ (ARMv6-M, 无 LDREX/STREX) 上会退化为
      libatomic 软件实现（IRQ 锁），单核正确但无法提供跨核互斥。

      True busy-wait spinlock using atomic test-and-set.
      Only safe on SMP/multi-core systems where the owning
      context can run on another core.
      Note: on M0/M0+ (ARMv6-M, no LDREX/STREX) this falls
      back to the libatomic software implementation (IRQ-lock),
      which is correct on a single core but cannot provide
      cross-core mutual exclusion.
endchoice
endmenu

menu "System Log"
choice
    prompt "Log backend"
    default SYS_LOG_USE_PRINTF
    help
      选择系统日志输出后端。

      Select system log output backend.

config SYS_LOG_USE_PRINTF
    bool "Direct printf"
    help
      通过普通 printf 输出日志。

      Output via plain printf.

config SYS_LOG_USE_ESP
    bool "ESP-IDF esp_log (ESP_LOG*, IDF only)"
    help
      通过 ESP-IDF esp_log.h 输出 (ESP_LOGI/ESP_LOGW/ESP_LOGE),
      带 tag 颜色与等级过滤, 受 menuconfig CONFIG_LOG_* 控制。
      仅 ESP-IDF 构建可用 (非 ESP 构建无 esp_log.h, 勿选)。

      Output via ESP-IDF esp_log.h (ESP_LOGI/ESP_LOGW/ESP_LOGE),
      with tag colors and level filtering controlled by CONFIG_LOG_*.
      ESP-IDF builds only (esp_log.h does not exist outside IDF).

config SYS_LOG_USE_OSAL
    bool "OSAL logging"
    help
      通过 OSAL 日志接口输出。

      Output via OSAL log interface.
endchoice
endmenu

menu "System Runtime"

config SYSTEM
    bool "System runtime (two-phase boot, watchdog, scrubber, task manager)"
    default y
    help
      System 模块总开关，默认自开启。
      包含两阶段启动 (pre_os_init / start_tasks)、看门狗 (IWDG/TWDT)、
      Flash CRC 巡检、任务管理器与安全停机等。
      关闭后 system_c/ 与 system_cpp/ 均不编入，EventBus 也会随之不可用
      (CONFIG_EVENT_BUS 依赖本项)。

      Master switch for the System module, enabled by default.
      Covers the two-phase boot (pre_os_init / start_tasks), watchdogs
      (IWDG/TWDT), Flash CRC scrubber, task manager and safe shutdown.
      When off, neither system_c/ nor system_cpp/ is compiled, and
      EventBus is unavailable too (CONFIG_EVENT_BUS depends on this).

choice
    prompt "System backend"
    depends on SYSTEM
    default SYSTEM_CPP
    help
      选择 C 或 C++ 系统后端。

      Select C or C++ system backend.

config SYSTEM_C
    bool "C"
    help
      纯 C 系统运行时。

      Pure C system runtime.

config SYSTEM_CPP
    bool "C++"
    help
      C++ 系统运行时。

      C++ system runtime.
endchoice

config SYSTEM_CMD
    bool "System command infra (SystemCmd)"
    default n
    depends on SYSTEM_CPP
    help
      SystemCmd 命令注册/派发基础设施 (system_cpp/src/system_cmd.cpp)。
      默认关闭; 需要命令行接口时再开启。
      SystemCmd command register/dispatch infra. Default off;
      enable only when a command-line interface is needed.
endmenu

menu "Components"

config USB
    bool "USB bus/VFS (TinyUSB)"
    default y
    help
      USB host/client 总线与 VFS（bus/usb + vfs/usb + hal/usb）。
      启用时板级必须提供 usb_tusb_port 粘合层（docs/usb_tusb_port.md）
      并自行链接 TinyUSB DCD；置 "not set" 时整条 USB 通路与
      TinyUSB 均不编入（CMake 按 .config 裁剪，缺省视为启用）。

      USB host/client bus and VFS (bus/usb + vfs/usb + hal/usb).
      When enabled, the board must supply the usb_tusb_port glue layer
      (docs/usb_tusb_port.md) and link TinyUSB DCD itself; setting it
      "not set" excludes the whole USB path and TinyUSB (CMake trims by
      .config; unset is treated as enabled by default).

    menu "TinyUSB 适配层"

        config USB_TUSB_MCU
            int "TinyUSB MCU target (OPT_MCU_* value)"
            default 901
            depends on USB
            help
              TinyUSB 编译期芯片目标, 直接填 tusb_option.h 的 OPT_MCU_* 数值
              (tusb_config.h 里 #define CFG_TUSB_MCU CONFIG_USB_TUSB_MCU):
                900 ESP32-S2   901 ESP32-S3   903 ESP32-C3
                304 STM32F4    306 STM32H7    1100 RP2040
              其他芯片查 lib/tinyusb/src/tusb_option.h 第 62-150 行的 OPT_MCU_*。

        choice
            prompt "TinyUSB OS port (auto-follow OSAL)"
            default USB_TUSB_OS_NONE
            depends on USB
            help
              由 OSAL Backend 自动派生 (select 联动), 无需手填。
              对应 tusb_option.h 的 OPT_OS_*:
                NONE=1 / FREERTOS=2 / RTTHREAD=3 / THREADX=4
              注意: 选 uC/OS 时 TinyUSB 无对应适配, 自动回退 NONE。

            config USB_TUSB_OS_NONE
                bool "None (bare-metal)"
            config USB_TUSB_OS_FREERTOS
                bool "FreeRTOS"
            config USB_TUSB_OS_RTTHREAD
                bool "RT-Thread"
            config USB_TUSB_OS_THREADX
                bool "ThreadX"
        endchoice

        config USB_TUSB_DEBUG
            bool "TinyUSB debug output (CFG_TUSB_DEBUG)"
            default n
            depends on USB
            help
              使能 TinyUSB 内部调试打印 (CFG_TUSB_DEBUG=1)。
              生产固件建议关闭。

        choice
            prompt "USB port0 role"
            default USB_RHPORT0_DEVICE
            depends on USB
            help
              USB 端口0 角色 (CFG_TUSB_RHPORT0_MODE 的模式位)。

            config USB_RHPORT0_DEVICE
                bool "Device"
            config USB_RHPORT0_HOST
                bool "Host"
        endchoice

        choice
            prompt "USB port0 max speed"
            default USB_RHPORT0_SPEED_FULL
            depends on USB
            help
              USB 端口0 最大速度 (CFG_TUSB_RHPORT0_MODE 的速度位)。

            config USB_RHPORT0_SPEED_DEFAULT
                bool "Default (MCU max)"
            config USB_RHPORT0_SPEED_FULL
                bool "Full speed"
            config USB_RHPORT0_SPEED_HIGH
                bool "High speed"
        endchoice

        config USB_MSC
            bool "USB MSC class"
            default n
            depends on USB
            help
              大容量存储 class (CFG_TUD_MSC)。

        config USB_HID
            bool "USB HID class"
            default n
            depends on USB
            help
              人机交互 class (CFG_TUD_HID)。

        config USB_VENDOR
            bool "USB Vendor class"
            default n
            depends on USB
            help
              厂商自定义 class (CFG_TUD_VENDOR)。

        config USB_CDC
            bool "USB CDC class"
            default n
            depends on USB
            help
              通信设备 class (虚拟串口, CFG_TUD_CDC)。

        config USB_CDC_RX_BUFSIZE
            int "USB CDC RX buffer size (bytes)"
            default 256
            range 64 2048
            depends on USB_CDC
            help
              CFG_TUD_CDC_RX_BUFSIZE: 主机→设备 FIFO 大小。

        config USB_CDC_TX_BUFSIZE
            int "USB CDC TX buffer size (bytes)"
            default 256
            range 64 2048
            depends on USB_CDC
            help
              CFG_TUD_CDC_TX_BUFSIZE: 设备→主机 FIFO 大小。

        config USB_CDC_EP_BUFSIZE
            int "USB CDC endpoint buffer size (bytes)"
            default 64
            range 8 512
            depends on USB_CDC
            help
              CFG_TUD_CDC_EP_BUFSIZE: CDC 端点传输缓冲 (对齐端点最大包)。

        config USB_NET
            bool "USB network class (ECM/RNDIS/NCM)"
            default y
            depends on USB
            help
              网络 class (net_device): 虚拟网卡数据面
              (usb_net_frame_push_tx/pop_rx + tud_network_* 回调)。
              lwIP 侧由 net/port/usbethif.c 经 usb_bus_ecm_* 接入。

        choice
            prompt "USB network protocol (RNDIS / NCM)"
            default USB_NET_RNDIS
            depends on USB_NET
            help
              网络 class 协议二选一 (net_device.h 禁止同时开):
                RNDIS: CFG_TUD_ECM_RNDIS 1, 兼容 Windows/Linux;
                NCM  : CFG_TUD_NCM 1, 需新主机 (Win10+/Linux 新内核)。

            config USB_NET_RNDIS
                bool "RNDIS"
            config USB_NET_NCM
                bool "NCM"
        endchoice

        config USB_NET_DEPTH
            int "USB net rx frame queue depth (power of 2)"
            default 4
            range 2 8
            depends on USB_NET
            help
              收帧 SPSC 队列深度 (2/4/8), 必须为 2 的幂
              (algorithm/buffer 的 fifo_init 要求)。

        config USB_NET_MTU
            int "USB net MTU (incl. ethernet header)"
            default 1514
            range 1514 1600
            depends on USB_NET
            help
              以太网帧总长 = lwIP MTU(1500) + 14 字节 ethhdr。
              默认 1514, 对齐 TinyUSB CFG_TUD_NET_MTU。
        endmenu
endmenu

menu "Board Features"

config PRODUCTION_LOG
    bool "Production log"
    default n
    help
      开启生产级日志。

      Enable production-level logging.

config PRODUCTION_LOG_SLOT_COUNT
    int "Production log slot count"
    default 32
    range 8 256
    depends on PRODUCTION_LOG
    help
      生产日志环形缓冲深度（槽位数）。

      Production-log ring buffer depth (slots).

config SAFETY_SHUTDOWN
    bool "Safety shutdown"
    default n
    help
      开启硬件级安全停机。

      Enable hardware-level safety shutdown.

config BOARD_MAX_SAFETY_PINS
    int "Max safety shutdown pins"
    default 8
    range 1 32
    depends on SAFETY_SHUTDOWN

config BOARD_SAFETY_MAX_CALLBACKS
    int "Max safety shutdown callbacks"
    default 4
    range 1 16
    depends on SAFETY_SHUTDOWN

config SYSTEM_WDT
    bool "Framework watchdog service (system_wdt)"
    default y
    depends on SYSTEM
    help
      框架自动看门狗服务: 两阶段启动时自动初始化 IWDG/TWDT、主循环与
      EventBus 自动喂狗、bootloop 防烧 Flash。
      注意: 这是框架引导集成的服务 (Kconfig 控制); 应用层可编程看门狗
      走 vfs-iwdg / vfs-wwdg (DTS 控制的外设驱动), 两者不冲突。
      Framework watchdog service: auto-inits IWDG/TWDT in the two-phase
      boot, auto-feeds in the main loop / EventBus, guards bootloop.
      This is a boot-integrated framework service (Kconfig-gated);
      app-programmable watchdogs go through vfs-iwdg / vfs-wwdg (DTS
      driven), they do not conflict.

config SYSTEM_SCRUBBER
    bool "Flash bit-rot scrubber (system_scrubber)"
    default n
    depends on SYSTEM
    help
      Flash 位腐烂巡检: 后台任务定期扫描 Flash 并校验 CRC 基线。
      默认关闭; 生产环境需要掉电/位翻转防护时开启。
      Independent of SYSTEM_WDT.
      Flash bit-rot scrubber: a background task periodically scans Flash
      and verifies the CRC baseline. Off by default; enable for
      power-loss / bit-flip protection in production.
      Independent of SYSTEM_WDT.
endmenu


menu "Runtime Capacity"

config EVENT_BUS
    bool "EventBus (publish/subscribe event bus)"
    default n
    depends on SYSTEM
    help
      EventBus 总开关，默认关闭。
      轻量发布/订阅事件总线，ISR 安全投递、启动后封口。
      依赖 System 模块 (喂狗与 SIOF 就绪标志)。
      关闭后 core/src/event_bus.c 不编入，系统不再广播 EVENT_SYS_*。

      Master switch for the EventBus, off by default.
      Lightweight publish/subscribe bus with ISR-safe post and
      seal-after-boot. Depends on the System module (watchdog feed
      and SIOF readiness flag). When off, core/src/event_bus.c is
      not compiled and no EVENT_SYS_* events are posted.

config EVENT_BUS_QUEUE_LEN
    int "Event bus queue depth"
    default 64
    range 8 256
    depends on EVENT_BUS

config EVENT_BUS_MAX_SUBSCRIBERS
    int "Event bus max subscribers"
    default 24
    range 4 64
    depends on EVENT_BUS

config EVENT_BUS_DISPATCH_STACK
    int "Event bus dispatch task stack (bytes)"
    default 2048
    range 512 8192
    depends on EVENT_BUS

config VIRQ
    bool "Virtual IRQ + bottom-half framework (VIRQ)"
    default y
    help
      VIRQ 虚拟中断总开关，默认自开启。
      包含 VIRQ 号分配、上/下半部框架与全局下半部轮询器。
      关闭后 interrupt/interrupt.c 不编入，系统主循环不再 poll 下半部。
      关闭前请确认以下功能不需要（关闭后不可用，板级/驱动需同步裁剪）：
        · 裸机时间片调度器 (time_slice/task/xtask)：默认 SysTick 路径 (内核异常,
          不经 VIRQ) 关闭 VIRQ 不受影响, 仍照常 tick; 仅当 DTS 显式配 chosen
          TIM (走通用 TIM + VIRQ) 时, 关闭 VIRQ 后该 TIM 中断无法路由, 调度器
          无 tick 源, x_scheduler_poll() 永不调度任务；
        · ADC/I2S DMA 中断下半部：vfs-adc / i2s_bus 跳过 VIRQ 注册与中断
          使能，异步/DMA 回调不可用（轮询模式驱动不受影响）；
        · GPIO 硬件中断路由：hal_gpio 的 virq_idx 槽位形同虚设；
        · 板级/驱动侧 ISR 不得再调用 interrupt_virtual_dispatch() /
          interrupt_virtual_register()，否则链接失败——关 VIRQ 时板级
          ISR 代码须同步裁剪。
      内存收益约 1.3 KB RAM + 1 KB Flash，详见 docs/memory_footprint.md。

      Master switch for the Virtual IRQ + bottom-half framework, on by default.
      When off, interrupt/interrupt.c is not compiled, drivers skip VIRQ
      registration, and the system loop stops polling the bottom half.
      Confirm these become unavailable before disabling (trim board/driver
      code accordingly):
        · bare-metal time-slice scheduler (time_slice/task/xtask): the default SysTick
          path (core exception, not via VIRQ) keeps ticking with VIRQ off; only
          when DTS explicitly sets chosen TIM (generic TIM + VIRQ) does disabling
          VIRQ break TIM IRQ routing — no tick source, tasks never run;
        · ADC/I2S DMA bottom-half offload: vfs-adc / i2s_bus skip VIRQ
          registration and IRQ enable — async/DMA callbacks dead (polling
          drivers unaffected);
        · GPIO hardware IRQ routing: the hal_gpio virq_idx slot goes inert;
        · board/driver ISRs must not call interrupt_virtual_dispatch() /
          interrupt_virtual_register() or the link fails — trim board ISR
          code accordingly.
      Memory saving ≈ 1.3 KB RAM + 1 KB Flash, see docs/memory_footprint.md §3.6.

config BOTTOM_HALF_QUEUE_DEPTH
    int "Interrupt bottom-half queue depth (power of two)"
    default 16
    range 4 128
    depends on VIRQ
    help
      VIRQ 下半部 FIFO 深度，必须是 2 的幂。

      Bottom-half FIFO depth; must be a power of two.

config OSAL_MUTEX_POOL_SIZE
    int "OSAL static mutex pool size"
    default 24
    range 4 256

config BOARD_STACK_MONITOR_MAX_TASKS
    int "Stack monitor max registered tasks"
    default 8
    range 1 32

endmenu

menu "Compiler Compatibility"

config COMPILER_GNU_EXTENSIONS
    bool "GNU compiler extensions (container_of, likely/unlikely)"
    default y
    help
      在 compiler_compat.h 中启用 GNU 语句表达式与内建函数。
      GCC 与 Clang 均支持。

      Enable GNU statement expressions and builtins in compiler_compat.h.
      Supported by GCC and Clang.

config COMPILER_WARN_UNUSED_RESULT
    bool "Warn on ignored results of HAL/bus APIs (COMPAT_WARN_UNUSED_RESULT)"
    default y
    depends on COMPILER_GNU_EXTENSIONS
    help
      为 HAL 与 bus 层关键 API 加注解，返回值被丢弃时编译器报警。
      默认开启：底层 (hal→bus) 保持强制检查，保证内部可靠性。
      开启后可用 COMPAT_IGNORE_RESULT() 主动压制。

      Annotate HAL and bus APIs so the compiler warns when return values
      are discarded. On by default: internal layers (hal→bus) keep strict
      checking. Use COMPAT_IGNORE_RESULT() to silence intentionally.

config DEVICE_WARN_UNUSED_RESULT
    bool "Warn on ignored results of device/VFS APIs (DEVICE_WARN_UNUSED_RESULT)"
    default n
    depends on COMPILER_GNU_EXTENSIONS
    help
      为对外暴露的 device/VFS API (device_open/read/write/ioctl 等)
      加注解，应用层丢弃返回值时编译器报警。
      默认关闭：应用层调用 device_* 可忽略返回值，写法更宽松；
      需要严格检查时再开启。

      Annotate the externally-exposed device/VFS APIs (device_open/read/
      write/ioctl, etc.) so the compiler warns when app-layer callers
      discard the return value. Off by default for a relaxed app style;
      turn on when strict checking is required.

endmenu

menu "Build Options"

config BUILD_DISASM
    bool "Generate disassembly listing"
    default y
    help
      构建后生成 .lst 反汇编清单。
      仅构建期产物，不影响 Flash/RAM 占用。

      Generate .lst disassembly listing after build.
      Build-time artifact only; does not affect Flash/RAM usage.
endmenu

menu "lwIP (TCP/IP Stack)"
    # lwIP 移植层配置。net/lwipopts.h 直接引用本菜单生成的 CONFIG_* 宏。
    # 端口头文件位置约定 (lwIP 内部固定 include):
    #   net/lwipopts.h       <- lwip/opt.h 引用 ("lwipopts.h")
    #   net/arch/cc.h        <- lwip/arch.h 引用 ("arch/cc.h")
    #   net/arch/sys_arch.h  <- lwip/sys.h  引用 ("arch/sys_arch.h")
    # bool 选中 => config.h 生成 "#define CONFIG_XXX 1"; 未选中 => 宏不存在
    #   (lwIP 中 #if XXX 将未定义视为  ert0, 即功能关闭)。

    config LWIP
        bool "Enable lwIP TCP/IP stack"
        default y
        help
          lwIP 协议栈总开关。选中后 net/ 端口层 (sys_arch.c) 会被编入, 且
          应用工程需调用 mini_tree_link_lwip() 拉取 lwIP 源码。关闭则端口层
          与 lwIP 均不编译 (不占 Flash/RAM)。CMake 经 .config 的 CONFIG_LWIP
          桥接决定是否 add_subdirectory(net)。

    config SYS
        bool "lwIP NO_SYS mode (bare-metal polling)"
        default y if OSAL_NULL
        default n
        help
          lwIP 的 NO_SYS 开关。选中 (=y) 时 NO_SYS=1, lwIP 以裸机轮询模式运行
          (不依赖任何 OS 原语, 不创建 tcpip 线程; 应用在主循环轮询
          sys_check_timeouts() 与网卡收包); 未选中时 NO_SYS=0, lwIP 创建
          tcpip 内核线程, 依赖"可阻塞切换的真 RTOS 线程"语义。

          硬约束: OSAL 后端为裸机 (OSAL_NULL + xtask 协调/抢占调度器) 时
          必须保持 y。xtask 任务是裸机协程, osal_queue/osal_sem 在裸机后端
          是环形缓冲 + 忙等, 没有"阻塞即切换线程"的语义——裸机下强行
          NO_SYS=0 会导致 tcpip 线程死锁或永不推进。默认值已按后端自动
          选择: OSAL_NULL => y, RTOS (FreeRTOS/RT-Thread/ThreadX/uC-OS) => n。

          Hard constraint: keep this enabled on bare-metal (OSAL_NULL).
          xtask tasks are bare-metal coroutines; osal_queue/osal_sem busy-wait
          with no block-and-switch semantics, so NO_SYS=0 would deadlock the
          tcpip thread. The default follows the OSAL backend automatically.

    config SYS_LIGHTWEIGHT_PROT
        bool "Lightweight protection (critical section via IRQ lock)"
        default y
        depends on SYS
        help
          NO_SYS=1 (裸机) 时用关中断 (SYS_ARCH_PROTECT) 保护 lwIP 内存分配等
          临界区, 单核裸机下安全且开销最小。
          NO_SYS=0 (RTOS) 模式下本选项不可见: 临界区由 sys_mutex 保护,
          本移植不提供 RTOS 模式下的轻量保护实现。

    config LWIP_COMPAT_MUTEX
        bool "Compat mutex (emulate sys_mutex_t with sys_sem_t)"
        default n
        help
          0 = 使用原生 sys_mutex_t (OSAL mutex); 1 = 用 sys_sem_t 模拟互斥锁。
          本移植提供原生 mutex, 保持默认 0。

    menu "TCP/IP Core Thread"
        # 仅 RTOS 后端可见: tcpip 内核线程需要"可阻塞切换"的真线程语义
        depends on !SYS && !OSAL_NULL

        config TCPIP_THREAD_NAME
            string "tcpip thread name"
            default "tcpip_thread"

        config TCPIP_THREAD_STACKSIZE
            int "tcpip thread stack size (bytes)"
            default 1024
            range 512 16384

        config TCPIP_THREAD_PRIO
            int "tcpip thread priority"
            default 6
            range 0 31
            help
              优先级数值含义随 OSAL 后端翻转, 切后端时须重新评估:
              FreeRTOS 数大优先高; RT-Thread 数小优先高;
              ThreadX / uC-OS 数小优先高。裸机 (OSAL_NULL) 下本项不可见。

        config TCPIP_MBOX_SIZE
            int "tcpip core mailbox size"
            default 8
            range 1 64
    endmenu

    menu "Default Receive Mailbox Sizes"
        # 仅 RTOS 后端可见: netconn/socket 接收邮箱依赖阻塞式 mbox
        depends on !SYS && !OSAL_NULL

        config DEFAULT_RAW_RECVMBOX_SIZE
            int "RAW recv mbox size"
            default 8
            range 1 64

        config DEFAULT_UDP_RECVMBOX_SIZE
            int "UDP recv mbox size"
            default 8
            range 1 64

        config DEFAULT_TCP_RECVMBOX_SIZE
            int "TCP recv mbox size"
            default 8
            range 1 64

        config DEFAULT_ACCEPTMBOX_SIZE
            int "TCP accept mbox size"
            default 8
            range 1 64
    endmenu

    menu "Memory"
        config MEM_ALIGNMENT
            int "Memory alignment (bytes)"
            default 4
            range 1 16
            help
              内存对齐字节数, 通常 4 (32-bit) 或 8。

        config MEM_SIZE
            int "lwIP heap size (bytes)"
            default 16384
            range 1024 1048576
            help
              lwIP 内部内存池 (mem.c) 总大小。0 表示不内置堆
              (配合 MEM_LIBC_MALLOC 使用系统 malloc)。

        config MEM_LIBC_MALLOC
            bool "Use system malloc instead of lwIP pool"
            default n
            help
              0 = 使用 lwIP 内部内存池 (裸机推荐); 1 = 使用系统 malloc/free。

        config MEMP_NUM_PBUF
            int "Number of pbuf structs"
            default 16
            range 1 512

        config MEMP_NUM_TCP_PCB
            int "Number of TCP PCBs"
            default 5
            range 1 64

        config MEMP_NUM_UDP_PCB
            int "Number of UDP PCBs"
            default 4
            range 1 64

        config MEMP_NUM_TCP_PCB_LISTEN
            int "Number of listening TCP PCBs"
            default 4
            range 1 64

        config MEMP_NUM_TCP_SEG
            int "Number of TCP segments"
            default 16
            range 1 512

        config MEMP_NUM_SYS_TIMEOUT
            int "Number of active timeouts"
            default 10
            range 1 128
    endmenu

    menu "PBUF Pool"
        config PBUF_POOL_SIZE
            int "Number of pbufs in pool"
            default 16
            range 1 512

        config PBUF_POOL_BUFSIZE
            int "Size of each pbuf in pool (bytes)"
            default 592
            range 64 2048
    endmenu

    menu "Protocols"
        config LWIP_RAW
            bool "RAW API"
            default n

        config LWIP_TIMERS
            bool "Protocol timers"
            default y

        config LWIP_UDP
            bool "UDP protocol"
            default y

        config UDP_TTL
            int "UDP default TTL"
            default 255
            range 1 255

        config LWIP_TCP
            bool "TCP protocol"
            default y

        config TCP_TTL
            int "TCP default TTL"
            default 255
            range 1 255

        config TCP_MSS
            int "TCP maximum segment size"
            default 536
            range 64 1460

        config TCP_WND
            int "TCP receive window"
            default 2048
            range 256 65535

        config TCP_SND_BUF
            int "TCP send buffer"
            default 2048
            range 256 65535

        config LWIP_ETHERNET
            bool "Ethernet support"
            default y

        config LWIP_CHECKSUM_CTRL_PER_NETIF
            bool "Per-netif checksum control"
            default n

        config LWIP_NETIF_STATUS_CALLBACK
            bool "Netif status callback"
            default y

        config LWIP_NETIF_LINK_CALLBACK
            bool "Netif link callback"
            default y

        config LWIP_NETIF_API
            bool "Netif API"
            default n

        config LWIP_ICMP
            bool "ICMPv4"
            default y

        config LWIP_ICMP6
            bool "ICMPv6"
            default n

        config LWIP_ARP
            bool "ARP"
            default y

        config ARP_TABLE_SIZE
            int "ARP table size"
            default 10
            range 1 128

        config LWIP_IPV4
            bool "IPv4"
            default y

        config LWIP_IPV6
            bool "IPv6"
            default n

        config IP_REASSEMBLY
            bool "IP reassembly"
            default y

        config IP_FRAG
            bool "IP fragmentation"
            default y

        config IP_FRAG_USES_STATIC_BUF
            bool "IP frag uses static buffer"
            default n

        config LWIP_DHCP
            bool "DHCP client"
            default y

        config LWIP_AUTOIP
            bool "AutoIP (APIPA)"
            default n

        config LWIP_DNS
            bool "DNS resolver"
            default y
            depends on LWIP_UDP
            help
              DNS 解析器基于 UDP, 需先启用 LWIP_UDP。
    endmenu

    menu "PPP (4G/Modem over Serial)"
        depends on LWIP

        config PPP_SUPPORT
            bool "Enable PPP (Point-to-Point Protocol)"
            default n
            help
              lwIP PPP 协议总开关。4G 模组 (a7670/air780e 等) 通过串口 PPP
              (pppos) 接入互联网时必选。PPP 依赖 TCP 与 IPv4, 拨号后由运营商
              分配 IP。HTTP/MQTT 等应用层库在 PPP netif 之上工作, 与链路无关。

        config PPPOS_SUPPORT
            bool "Enable PPP over Serial (pppos)"
            default y if PPP_SUPPORT
            default n
            depends on PPP_SUPPORT
            help
              PPP over Serial: 把串口裸字节流封装为 PPP 帧。pppif 适配层通过
              pppos_create() 创建 netif, 输出回调把 PPP 帧写入模组串口, 串口
              收包方向每收到一字节调用 pppos_input() 喂给协议栈。

        config PAP_SUPPORT
            bool "Enable PAP authentication"
            default y if PPP_SUPPORT
            default n
            depends on PPP_SUPPORT
            help
              明文 PAP 认证。多数 4G 模组拨号 (ATD*99#) 不需要用户名密码, 但
              部分运营商 APN 需 PAP/CHAP。按需开启。

        config CHAP_SUPPORT
            bool "Enable CHAP authentication"
            default y if PPP_SUPPORT
            default n
            depends on PPP_SUPPORT
            help
              加密 CHAP 认证。比 PAP 更安全, 同上按需开启。

        config PPP_IPV6_SUPPORT
            bool "Enable PPP IPv6 (IPV6CP)"
            default y if PPP_SUPPORT && LWIP_IPV6
            default n
            depends on PPP_SUPPORT
            help
              PPP 链路上的 IPv6 (IPV6CP) 协商。仅当 LWIP_IPV6=y 且运营商支持
              双栈时开启。默认跟随 IPv6 总开关。

        config PPP_INPROC_IRQ_SAFE
            bool "PPP input from ISR-safe context"
            default n
            depends on PPP_SUPPORT
            help
              允许在中断上下文调用 pppos_input() (裸机/ISR 收包时)。开启会增加
              少量开销换取 ISR 直收。NO_SYS=1 裸机轮询模式若由 UART ISR 直接
              喂字节, 建议开启; RTOS 模式一般无需。

        config PPP_MAXMRU
            int "PPP MRU (max receive unit)"
            default 1500
            range 128 1500
            depends on PPP_SUPPORT
            help
              PPP 最大接收单元。需 >= 链路 MTU, 一般 1500 对齐以太网帧。

        config PPP_MAXMTU
            int "PPP MTU (max transmit unit)"
            default 1500
            range 128 1500
            depends on PPP_SUPPORT
            help
              PPP 最大发送单元。与运营商协商, 一般 1500。

        menu "PPPIF (pppif 适配层)"

            config PPPIF_RX_BUF_SIZE
                int "PPP 数据态接收缓冲大小 (bytes)"
                default 512
                range 128 4096
                depends on PPPOS_SUPPORT
                help
                  pppif 数据态轮询接收缓冲, device_read 单次最多读入的字节数。
                  需 >= PPP_MRU 对齐链路最大帧, 一般 512 足够 (PPP 帧 1500 字节
                  时按 512 分片多次喂入 pppos_input)。

            config PPPIF_RX_TASK_STACK_SIZE
                int "PPP 接收任务栈大小 (bytes)"
                default 2048
                range 512 16384
                depends on PPPOS_SUPPORT
                help
                  若移植层用独立接收任务喂 pppos_input (RTOS 模式), 该任务栈大小;
                  NO_SYS 裸机轮询模式 (pppif_poll 主循环) 不创建任务, 本项仅用于
                  预留/后续移植扩展。

            config PPPIF_RX_TASK_PRIO
                int "PPP 接收任务优先级"
                default 6
                range 1 32
                depends on PPPOS_SUPPORT
                help
                  接收任务优先级 (仅 RTOS 模式使用)。裸机轮询模式无任务, 忽略。
        endmenu
    endmenu

    menu "Checksum"
        config CHECKSUM_GEN_IP
            bool "Generate IP checksum"
            default y

        config CHECKSUM_GEN_UDP
            bool "Generate UDP checksum"
            default y

        config CHECKSUM_GEN_TCP
            bool "Generate TCP checksum"
            default y

        config CHECKSUM_CHECK_IP
            bool "Verify incoming IP checksum"
            default y

        config CHECKSUM_CHECK_UDP
            bool "Verify incoming UDP checksum"
            default y

        config CHECKSUM_CHECK_TCP
            bool "Verify incoming TCP checksum"
            default y
    endmenu

    menu "Socket / Netconn API"
        # 仅 RTOS 后端可见: netconn/socket API 阻塞语义依赖真线程
        depends on !SYS && !OSAL_NULL

        config LWIP_NETCONN
            bool "Netconn API"
            default y
            help
              Netconn 顺序 API, Socket API 的底层。关闭后 Socket 亦不可用。

        config LWIP_SOCKET
            bool "BSD Socket API"
            default y
            depends on LWIP_NETCONN
            help
              BSD Socket API, 建立在 Netconn 之上, 需先启用 LWIP_NETCONN。

        config LWIP_NETCONN_RECVTIMEO
            bool "Netconn recv timeout"
            default y
            depends on LWIP_NETCONN

        config LWIP_SO_RCVTIMEO
            bool "SO_RCVTIMEO support"
            default y
            depends on LWIP_SOCKET

        config LWIP_SO_SNDTIMEO
            bool "SO_SNDTIMEO support"
            default y
            depends on LWIP_SOCKET

        config LWIP_SO_RCVBUF
            bool "SO_RCVBUF support"
            default n
            depends on LWIP_SOCKET

        config LWIP_TIMEVAL_PRIVATE
            bool "Private struct timeval"
            default y
            depends on LWIP_SOCKET
            help
              1 = 使用 lwIP 内置 struct timeval (裸机无 <sys/time.h>, 必须开启);
              0 = 使用系统 <sys/time.h> 的 timeval (仅宿主/ Linux 构建适用)。

        config LWIP_POSIX_SOCKETS_IO_NAMES
            bool "Map read/write/close to socket API"
            default y
            depends on LWIP_SOCKET
    endmenu

    menu "Socket/Netconn Memory Pools"
        # 仅 RTOS 后端可见: 与 Socket/Netconn API 同生命周期
        depends on !SYS && !OSAL_NULL

        config MEMP_NUM_NETCONN
            int "Number of netconns"
            default 8
            range 1 128

        config MEMP_NUM_NETBUF
            int "Number of netbufs"
            default 8
            range 1 128

        config MEMP_NUM_SELECT_CB
            int "Number of select callbacks"
            default 4
            range 1 64

        config MEMP_NUM_TCPIP_MSG_API
            int "Number of tcpip API messages"
            default 16
            range 1 256

        config MEMP_NUM_TCPIP_MSG_INPKT
            int "Number of tcpip input-packet messages"
            default 16
            range 1 256
    endmenu

    menu "Debug"
        config LWIP_DEBUG
            bool "lwIP debug output"
            default n

        config LWIP_STATS
            bool "lwIP statistics"
            default n
    endmenu
endmenu

endmenu
