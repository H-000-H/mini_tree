# mini_tree 中间件通用 clangd（Linux / Windows）
# - include 路径放在根目录 compile_flags.txt（其目录 = 编译 cwd，相对 -I 才正确）
# - 禁止在子目录再放 compile_flags.txt（会覆盖根配置，且相对路径常失效）
# - 生成头用 ide/stubs；ETL 用 ide/third_party/etl（clone 到该目录即可，已 gitignore）
# - 勿在本文件用相对 -I：fallback 的 cwd 是源文件所在目录，-Icore/include 会找错
# - 有 compile_commands.json 时优先用之；本文件只做 Merge（Remove / 语言切换）
# 用法：打开 mini_tree 根目录；改完后命令面板执行 Clangd: Restart language server

CompileFlags:
  Remove:
    - --target=*
    - -mcpu=*
    - -mfpu=*
    - -mfloat-abi=*
    - -fdata-sections
    - -ffunction-sections

Diagnostics:
  UnusedIncludes: None
  Suppress:
    - drive_mode_mismatch

---
# 头文件当 C header 解析（跳转 / 补全）
If:
  PathMatch: .*\.(h|H)$
CompileFlags:
  Remove:
    - -std=*
  Add:
    - -x
    - c-header
    - -std=gnu17

---
# C++ 源
If:
  PathMatch: .*\.(cpp|cxx|cc|hpp|hxx)$
CompileFlags:
  Remove:
    - -std=*
  Add:
    - -std=gnu++17
    - -x
    - c++

---
# DTS/DTSI：当 C 解析以便 #include / 宏跳转（语法噪声压掉）
# include 路径已在 compile_flags.txt；此处只改语言模式
If:
  PathMatch: .*\.dtsi?$
CompileFlags:
  Add:
    - -std=gnu17
    - -x
    - c
Diagnostics:
  Suppress: "*"
