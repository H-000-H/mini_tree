# clangd 配置
# 1. 固件源码使用 CMake 导出的编译数据库。CompilationDatabase 是相对本文件所在目录解析的:
#    本工程作为 mini_tree 子目录编入时, 数据库在工程根 build/Debug (即本目录的 ../../../build/Debug);
#    早期写的 build/Debug 会被解析成 mini_tree/lib/mini-ota/build/Debug(不存在) → 参数全丢、假错满屏。
# 2. ARM 编译 flags 只对固件源码生效，绝不能放进默认块：否则会泄漏给 test/ 下
#    的主机端文件（报 -mfloat-abi unsupported、系统头解析错位等假错）
CompileFlags:
  CompilationDatabase: ../../../build/Debug

---
# 固件源码（ARM 交叉）：clangd 不会从 arm-none-eabi-gcc 路径推断交叉目标
# （CMake 会把含空格的编译器路径转成 8.3 短名 AR19DD~1.EXE），需显式指定目标三元组，
# 否则 -mcpu 会按 x86 解析报错。armv7em = Cortex-M4/M7；切 M0/M3 时改成 armv6m/armv7m
# 3. Compiler 指定真实驱动名，让 clangd 按 GCC 驱动模式解析
If:
  PathMatch: [bootutil/.*, algorithm/.*, arch/.*, configs/.*, lib/.*]
CompileFlags:
  Compiler: arm-none-eabi-gcc
  Add:
    - --target=armv7em-none-eabi
    # 与真实构建保持一致：工程未开 FPU 选项，arm-none-eabi-gcc 默认即 soft ABI。
    # 若这里让 clang 走硬浮点，CMSIS 会编入 FPSCR 相关代码，其 __builtin_arm_cdp
    # 在 clang 下要求常量参数而报错（GCC 侧则无此问题）。
    - -mfloat-abi=soft

---
# test/ 主机端测试代码：使用 g++ + Ninja 单独导出的编译数据库
# （test/build 默认是 VS 生成器，导出不了 compile_commands.json；
#   该目录只给 clangd 用，不参与实际构建，实际构建仍走 MSVC）
If:
  PathMatch: test/.*
CompileFlags:
  CompilationDatabase: test/build/clangd
  Compiler: g++
