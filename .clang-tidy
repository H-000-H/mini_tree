---
# mini_tree 命名规范（clang-tidy readability-identifier-naming）= Linux 内核命名
# 全仓一致: 标识符全小写 snake_case, 不加 s_/g_/k_ 前缀（内核风, 非 Google 作用域前缀）,
#   函数以模块名作前缀; 宏定义全大写。
# C++ 构造（class/union/enum/typedef/别名）用 PascalCase、namespace 小写 —— 内核没有
#   C++ 类型可参照, 这是唯一保留的 Google 习惯, app/ 与 system_cpp/ 同样如此。
# 分层: 本文件管内核区（app 以下 + 非 cpp 文件）; app/ 与 system_cpp/ 见各自 .clang-tidy。
# 例外（内核风格 API）: container_of/offsetof/likely/unlikely/mini_pre_execution、
#   IS_ERR/PTR_ERR/ERR_PTR、COMPAT_*、__XXX_H__ 头文件卫士。
# 注意: 文件作用域 static 与 extern 全局均归 GlobalVariable, 仅强制小写,
#       前缀由 code review 把关。
# 使用: clang-tidy -p build <file>  （clangd / IDE / CI 直接读取本文件）

Checks: '-*,readability-identifier-naming'

CheckOptions:
  # ── C++ class: Google 风格 PascalCase（clang-tidy 写作 CamelCase）──
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  # ── C 中间件类型: 小写（struct event_bus / event_callback_t）──
  - key: readability-identifier-naming.StructCase
    value: lower_case
  - key: readability-identifier-naming.UnionCase
    value: lower_case
  - key: readability-identifier-naming.EnumCase
    value: lower_case
  - key: readability-identifier-naming.TypedefCase
    value: lower_case
  # ── C++ using 别名: Google 风格 PascalCase（CamelCase）──
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  # ── 枚举值: 大写（Google 允许枚举值用 ALL_CAPS，与现有代码一致）──
  - key: readability-identifier-naming.EnumConstantCase
    value: UPPER_CASE
  # ── namespace: Google 风格小写 ──
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case

  # ── 函数: 小写（内核风格 API 名例外: IS_ERR/COMPAT_* 等 static inline）──
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.FunctionIgnoredRegexp
    value: '^(ERR_PTR|PTR_ERR|IS_ERR|IS_ERR_OR_NULL|COMPAT_[A-Z0-9_]+)$'

  # ── 变量: 全内核风格 仅小写, 无前缀要求 ──
  - key: readability-identifier-naming.GlobalVariableCase
    value: lower_case
  - key: readability-identifier-naming.StaticVariableCase
    value: lower_case
  - key: readability-identifier-naming.LocalVariableCase
    value: lower_case
  - key: readability-identifier-naming.MemberVariableCase
    value: lower_case
  - key: readability-identifier-naming.FunctionParameterCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case

  # ── 常量: 全内核风格 仅小写, 无 k_ 前缀要求 ──
  - key: readability-identifier-naming.GlobalConstantCase
    value: lower_case
  - key: readability-identifier-naming.StaticConstantCase
    value: lower_case
  - key: readability-identifier-naming.MemberConstantCase
    value: lower_case
  - key: readability-identifier-naming.LocalConstantCase
    value: lower_case
  - key: readability-identifier-naming.ConstantParameterCase
    value: lower_case
  - key: readability-identifier-naming.ConstantCase
    value: lower_case

  # ── 宏: 全大写，container_of / likely / 头文件卫士等内核风格宏例外 ──
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  - key: readability-identifier-naming.MacroDefinitionIgnoredRegexp
    value: '^(container_of|container_of_const|offsetof|typeof_member|likely|unlikely|mini_pre_execution|__[A-Z0-9_]+__)$'
