# mini_tree Kconfig
# Edit mini_tree/.config or run tools/menuconfig.py

menu "mini_tree Configuration"

menu "Platform"
choice
    prompt "Target MCU"
    default PLATFORM_ARM_CM4F
    help
      Select the target processor architecture.

config PLATFORM_ARM_CM7
    bool "ARM Cortex-M7"

config PLATFORM_ARM_CM4F
    bool "ARM Cortex-M4F"

config PLATFORM_ARM_CM3
    bool "ARM Cortex-M3"

config PLATFORM_ARM_CM0
    bool "ARM Cortex-M0 / M0+"

config PLATFORM_RISCV
    bool "RISC-V (32-bit)"
endchoice
endmenu

menu "Multi-core Configuration"

config CPU_CORES
    int "Number of CPU cores"
    default 1
    range 1 2
    help
      CPU 核心数量。1 = 单核模式（默认）。
      2 = 双核 AMP 模式，Core 0 跑 RTOS，
      Core 1 跑裸机代码。
      设为 2 时板级需实现
      hal_cpu_secondary_startup()。

config AMP_MODE
    bool "AMP mode (multi-core)"
    depends on CPU_CORES > 1
    default y
    help
      双核 AMP 模式使能。AMP 模式下 osal_null 的互斥锁
      等同步原语使用原子 CAS 实现；单核模式下退化为
      关中断 + 普通变量访问，减少开销。
      注意: M0/M0+ (ARMv6-M) 无 LDREX/STREX 指令, 跨核
      原子性无硬件保证; 若 M0 作异构从核, 应避免跨核共享锁。
      Dual-core AMP mode. Under AMP, osal_null mutexes use
      atomic CAS; single-core falls back to IRQ-lock + plain
      access. Note: M0/M0+ (ARMv6-M) has no LDREX/STREX, so
      cross-core atomicity is not guaranteed; when M0 is a
      heterogeneous slave core, avoid sharing locks across cores.

endmenu

menu "OSAL Backend"
choice
    prompt "RTOS backend"
    default OSAL_NULL
    help
      Select the OS abstraction layer backend.

config OSAL_FREERTOS
    bool "FreeRTOS"
    help
      Use bundled or project-supplied FreeRTOS.

config OSAL_RTTHREAD
    bool "RT-Thread"
    help
      Use RT-Thread kernel as OSAL backend.

config OSAL_NULL
    bool "None (bare-metal)"
    help
      No RTOS. Queue uses ring buffer + busy-wait.
endchoice

config OSAL_NULL_MAX_QUEUES
    int "Bare-metal queue pool size (base)"
    default 0
    range 0 8
    depends on OSAL_NULL
    help
      裸机队列池基础大小 (静态预分配, 供手动 osal_queue_create 使用)。
      开启 EVENT_BUS 时自动在此基础上 +1 (EventBus 需要一个队列);
      关闭 (默认) 时仅基础数。
      Base bare-metal static queue pool size (for manual osal_queue_create).
      When EVENT_BUS is enabled, 1 is auto-added on top (EventBus needs a
      queue); when off (default), only the base counts.

config OSAL_NULL_QUEUE_BUF_SZ
    int "Per-queue buffer size (bytes)"
    default 2048
    range 512 8192
    depends on OSAL_NULL
    help
      每个队列静态内嵌的元素缓冲 (字节)。
      2048 B = 512 个基础单元, EventBus (64×8 B) 约占 1/4。
      下限 512 B 保证默认 EventBus 队列 (128 单元) 可创建。
      Element buffer embedded in each bare-metal queue.
      2048 B = 512 base units; EventBus (64×8 B) uses ~1/4.
      Lower bound 512 B keeps the default EventBus queue (128 units) creatable.

config OSAL_NULL_TASK_CPP
    bool "Bare-metal task create C++ wrapper (unified OSAL vs raw xtask)"
    default y
    depends on OSAL_NULL && SYSTEM_CPP
    help
      裸机任务创建的 C++ 封装 (osal/src/osal_task.cpp), 需要 SYSTEM_CPP (C++ 构建)。
      开启 (默认): 走统一 OSAL 路径 — 通过 C++ 重载 osal_task_create() 创建
      xtask 周期任务, 返回 etl::optional<x_task_handle_t>, 调用习惯与 OS 后端
      对齐 (参数语义见 osal_null.h 中该重载的注释)。
      关闭: 靠 xtask 自己 — 不编译封装, 直接调用 xscheduler_task_create() /
      x_scheduler_poll() 等 xtask 原生 API。
      仅裸机 (CONFIG_OSAL_NULL) 生效; OS 后端任务创建始终走标准 C API。

      Bare-metal task-create C++ wrapper (osal/src/osal_task.cpp), needs
      SYSTEM_CPP (C++ build). On (default): unified OSAL path — create
      xtask periodic tasks via the C++ overload osal_task_create(), which
      returns etl::optional<x_task_handle_t> and keeps the OSAL calling
      convention (parameter semantics are documented on that overload in
      osal_null.h). Off: raw xtask — the wrapper is not compiled; call
      xscheduler_task_create() / x_scheduler_poll() directly.
      Bare-metal (CONFIG_OSAL_NULL) only; on OS backends task creation
      always goes through the standard C API.

config FREERTOS_USE_TIMERS
    bool "FreeRTOS software timers"
    default n
    depends on OSAL_FREERTOS
    help
      Enable FreeRTOS software timers (configUSE_TIMERS in
      lib/freeRTOS/FreeRTOSConfig.h). Default off.

config FREERTOS_HEAP_SIZE
    int "FreeRTOS heap size (bytes)"
    default 8192
    range 2048 131072
    depends on OSAL_FREERTOS
    help
      FreeRTOS 动态堆大小 (configTOTAL_HEAP_SIZE), 供任务栈/信号量/队列分配。
      默认 8 KB; 任务多/栈大时按需调大。
      FreeRTOS dynamic heap (configTOTAL_HEAP_SIZE) for task stacks,
      semaphores and queues. Default 8 KB; raise when many/large tasks.

config RTT_HEAP_SIZE
    int "RT-Thread heap size (bytes)"
    default 32768
    range 4096 1048576
    depends on OSAL_RTTHREAD
    help
      RT-Thread 独立系统堆大小 (s_rtt_heap, 静态 .bss), 供线程栈/IPC 分配。
      默认 32 KB。
      RT-Thread independent system heap (static .bss) for stacks and IPC.
      Default 32 KB.
endmenu

menu "OSAL Spinlock"
choice
    prompt "Spinlock implementation"
    default OSAL_SPINLOCK_IRQ_DISABLE
    help
      Select the underlying spinlock implementation.

config OSAL_SPINLOCK_IRQ_DISABLE
    bool "Disable interrupts (single-core safe)"
    help
      Map spinlock to irq_disable/irq_restore. Safe for bare-metal
      and single-core RTOS. This is the default.

config OSAL_SPINLOCK_ATOMIC
    bool "Atomic test-and-set (busy-wait)"
    help
      True busy-wait spinlock using atomic test-and-set.
      Only safe on SMP/multi-core systems where the owning
      context can run on another core.
      Note: on M0/M0+ (ARMv6-M, no LDREX/STREX) this falls
      back to the libatomic software implementation (IRQ-lock),
      which is correct on a single core but cannot provide
      cross-core mutual exclusion.
endchoice
endmenu

