/*
 * ESP32-S3-DevKitC-1 — 默认 BOARD_DTS
 */

/dts-v1/;

#include "esp32s3.dtsi"
#include "esp32s3-gpio.dtsi"
#include "esp32s3-board-gpios.dtsi"
#include "esp32s3-uart.dtsi"
#include "esp32s3-spi.dtsi"
#include "esp32s3-i2c.dtsi"
#include "esp32s3-can.dtsi"
#include "esp32s3-tim.dtsi"
#include "esp32s3-adc.dtsi"
#include "esp32s3-ws2812.dtsi"
#include "esp32s3-st7789.dtsi"
#include "esp32s3-max98357a.dtsi"
#include "esp32s3-product-drivers.dtsi"

/chosen {
	tick-rate = <1000>;
	heap-size = <32768>;
};

/ {
	#address-cells = <1>;
	#size-cells = <0>;

	model = "Espressif ESP32-S3-DevKitC-1";
	compatible = "espressif,esp32-s3-devkitc-1", "espressif,esp32s3";
};

&gpios_pin {
	gpio-pin = <0>;
	status = "okay";
};

&uart1 {
	status = "okay";
};

&uart1_client {
	status = "okay";
};

&spi1 {
	status = "okay";
	max-trans-buffer = <2048>;
};

&spi1_slave_client {
	status = "okay";
};

&spi2 {
	status = "disabled";
	max-trans-buffer = <2048>;
};

&spi2_master_client {
	status = "disabled";
};

&w25qxx_0 {
	status = "disabled";
};

&ws2812_rgb {
	gpio-pin = <48>;
	status = "okay";
};
