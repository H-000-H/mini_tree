# mini_tree Kconfig — 公共配置树 (ESP / 非 ESP 共用)
# 本文件不包含 mainmenu; 由根 Kconfig (非 ESP) 或 Kconfig.projbuild (ESP-IDF) source 进去。
# 编辑 .config 或运行 tools/menuconfig.py

menu "mini_tree Configuration"

    menu "Platform"
        choice
            prompt "Target MCU"
            default PLATFORM_ARM_CM4F
            help
                Select the target processor architecture.

            config PLATFORM_ARM_CM7
                bool "ARM Cortex-M7"

            config PLATFORM_ARM_CM4F
                bool "ARM Cortex-M4F"

            config PLATFORM_ARM_CM3
                bool "ARM Cortex-M3"

            config PLATFORM_ARM_CM0
                bool "ARM Cortex-M0 / M0+"

            config PLATFORM_RISCV
                bool "RISC-V (32-bit)"

            config PLATFORM_ESP32
                bool "Espressif ESP32 (ESP-IDF)"
                help
                    Espressif ESP32 系列 (Xtensa; RISC-V 的 ESP32-C 系列在 IDF 下也选此项)。
                    ESP-IDF 工程**必须**选中此项 (sdkconfig.defaults 显式设置), 作为工程
                    平台身份声明; 非 ESP 裸机构建不要选它, 用 ARM / RISC-V 平台选项。

                    编译行为本身由 IDF 管理 (ESP_PLATFORM 编译宏 + cmake/esp_idf.cmake),
                    本选项不直接参与编译裁剪; 但它标识"本工程是 ESP 平台", 与 HAL
                    全屏蔽机制配套: ESP 构建下 mini_tree 的 HAL weak stub 被
      #if defined(ESP_PLATFORM) 屏蔽, 板级组件 (hal_<soc>) 必须提供
                    strong 实现, 缺失直接链接报错。

                    Espressif ESP32 series (Xtensa; ESP32-C RISC-V parts also select
                    this when built with ESP-IDF). ESP-IDF projects MUST select this
                    (set in sdkconfig.defaults) as a platform identity declaration;
                    non-ESP bare-metal builds must keep the ARM / RISC-V options.

                    Compilation is managed by IDF itself (ESP_PLATFORM macro +
                    cmake/esp_idf.cmake); this option does not directly drive the
                    build, but declares "this project is ESP", pairing with the HAL
                    shutdown: on ESP builds mini_tree HAL weak stubs are excluded by
      #if defined(ESP_PLATFORM) and the board component (hal_<soc>)
                    must provide strong implementations (link error if missing).
        endchoice
    endmenu

    menu "Multi-core Configuration"

        config CPU_CORES
            int "Number of CPU cores"
            default 1
            range 1 2
            help
                CPU 核心数量。1 = 单核模式（默认）。
                2 = 双核 AMP 模式: Core 0 跑 RTOS, Core 1 跑裸机代码,
                板级需实现 hal_cpu_secondary_startup()。
                AMP 下裸机的互斥锁等同步原语自动改用原子 CAS, 单核退化
                为关中断 + 普通变量访问 (省开销) —— 无独立开关, 由本项派生。
                注意: M0/M0+ (ARMv6-M) 无 LDREX/STREX, 跨核原子性无硬件
                保证; 这类目标配 2 核会被编译期守卫拒绝 (确知不存在跨核
                共享锁时, 可定义 MINI_AMP_NO_ATOMIC_OK 显式豁免)。

                Number of CPU cores. 1 = single-core mode (default).
                2 = dual-core AMP mode: Core 0 runs the RTOS, Core 1 runs
                bare-metal code; the board must implement
                hal_cpu_secondary_startup(). Under AMP the bare-metal mutex
                and friends automatically switch to atomic CAS (single-core
                falls back to IRQ-lock + plain access) — there is no separate
                switch; it is derived from this option.
                Note: M0/M0+ (ARMv6-M) has no LDREX/STREX, so cross-core
                atomicity is not guaranteed; such targets are rejected by a
                compile-time guard when CPU_CORES=2 (define
                MINI_AMP_NO_ATOMIC_OK if you know no lock is shared).

    endmenu

